DATABASE_URL=postgresql://imsda:imsda_dev@localhost:5432/imsda_events?schema=public
# Password for the Postgres container in docker-compose.yml. It must match the
# one in DATABASE_URL above. A deployment sets its own strong value and does not
# provide DATABASE_URL at all — docker-compose.yml composes it from this. Use
# `openssl rand -hex 32` in production so URL punctuation cannot change how the
# generated connection string is parsed.
POSTGRES_PASSWORD=imsda_dev
APP_BASE_URL=http://localhost:3000
APP_RELEASE_SHA=
# Compose publishes the app on 3100 by default. On a server, point the reverse
# proxy at this port and set APP_BASE_URL to the final public HTTPS origin.
APP_PORT=3100
# Required in production to derive retry-stable private links without storing
# their raw bearer tokens. Use a random value of at least 32 characters.
# Where uploaded event files (flyers, schedules) are written. Blank keeps local
# development under ./storage/event-assets. Production Compose overrides this
# with /app/storage/event-assets and mounts the imsda_events_assets volume.
ASSET_STORAGE_DIR=

MANAGE_LINK_DERIVATION_SECRET=
# During rotation, retain the prior value through the email retry window.
MANAGE_LINK_DERIVATION_SECRET_PREVIOUS=

# Signs stateless, PII-free attendee QR passes. Production requires a random
# value of at least 32 characters. Passes expire 48 hours after the event ends.
ATTENDEE_PASS_SIGNING_SECRET=
# During rotation, keep the prior value until every pass it signed has expired.
ATTENDEE_PASS_SIGNING_SECRET_PREVIOUS=

# Keyed, one-way request identifiers for durable abuse protection.
# Production requires a unique random value of at least 32 characters.
RATE_LIMIT_HASH_SECRET=
# Keep 0 unless the app is reachable only through exactly this many trusted
# proxies. X-Forwarded-For is ignored when this is 0.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0
RATE_LIMIT_CLIENT_IP_HEADER=x-forwarded-for

# Public forms may be framed only by these origins. Add approved church origins
# here; changing the list requires rebuilding the image.
EMBED_ALLOWED_ORIGINS='self' https://imsda.org https://*.imsda.org

# Pathfinder Health Record (#611). Keep false. Real health records stay switched
# off until ADR 0005 Addendum B is Accepted and the SECRET_ENCRYPTION_KEY backup
# has been test-restored. docker-compose.yml deliberately does not pass it on.
HEALTH_RECORDS_ENABLED=false

# Church map locations (#724). When true, a system administrator can click
# "Find map locations" to send church street addresses to the U.S. Census
# Bureau geocoder (geocoding.geo.census.gov, no API key). Production needs
# outbound HTTPS to that host. Off by default; nothing is sent when false.
# GEOCODING_PROVIDER=fake is an offline stand-in for local work only.
GEOCODING_ENABLED=false

# Authorises the scheduled outbox sweep, which retries messages that failed
# their first delivery attempt. Production requires at least 32 characters; the
# sweep endpoint is always 401 when this is unset.
OUTBOX_SWEEP_TOKEN=
OUTBOX_SWEEP_INTERVAL_SECONDS=300

# Optional: lets the server's deploy and cleanup jobs report a run to the System
# report (#1382). At least 32 characters; the endpoint is always 401 when unset.
HOST_JOB_HEARTBEAT_TOKEN=

# Optional (#1400): lets an uptime monitor read the detailed /api/health (release,
# backups, outbox, sweep) with "Authorization: Bearer <token>" without holding the
# sweep token. At least 32 characters; unset means only the sweep token or a system
# administrator sees the detail. The public answer is just status and database.
HEALTH_MONITOR_TOKEN=

# Read-only check of the production backups in Cloudflare R2 (#1412). Production backups
# are made by xCloud, outside the app; with these set, the System report shows the newest
# database and files backup. Use an R2 API token with Object Read only, limited to the
# backup bucket (docs/BACKUPS.md). Leave all blank to show "managed outside the app".
BACKUP_R2_READ_ACCOUNT_ID=
BACKUP_R2_READ_ACCESS_KEY_ID=
BACKUP_R2_READ_SECRET_ACCESS_KEY=
BACKUP_R2_READ_BUCKET=
# Optional: only look under this folder in the bucket.
BACKUP_R2_READ_PREFIX=
# Optional: comma-separated file-name patterns ("*" only). Defaults shown.
BACKUP_R2_READ_DATABASE_PATTERNS=
BACKUP_R2_READ_FILES_PATTERNS=

# Message files (#845): attachments and pictures staff upload for email, kept under
# ASSET_STORAGE_DIR/message-files/<eventId>/. The quota is the most one event may keep
# (default 200). The grace period is how old an unreferenced upload must be before the
# sweep may remove it (default 72, never less than 24). The scheduled sweep only REPORTS
# what it would remove unless MESSAGE_FILE_SWEEP_DELETE is exactly "true". See the
# delivery runbook before turning deletion on.
MESSAGE_FILE_EVENT_QUOTA_MB=
MESSAGE_FILE_SWEEP_GRACE_HOURS=
MESSAGE_FILE_SWEEP_DELETE=

# External email delivery. Blank keeps event messaging on local capture, but
# production requires a key: activation and password reset email have no other
# path, and an operator cannot hand a link to every colleague.
#
# EMAIL_PROVIDER picks the sender: unset or `resend` keeps Resend (below);
# `ses` sends through Amazon SES over SMTP with IAM SMTP credentials (#861).
EMAIL_PROVIDER=
SES_REGION=
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
# Optional: SES_CONFIGURATION_SET, SES_MAX_SEND_RATE (default 10 a second),
# and SES_SMTP_HOST / SES_SMTP_PORT (tests only).
# SES_SNS_TOPIC_ARN and SES_AWS_ACCOUNT_ID turn on bounce, complaint and delivery
# reports from SES through SNS (#863); see docs/DEPLOY-DOCKER.md.
SES_SNS_TOPIC_ARN=
SES_AWS_ACCOUNT_ID=
# Optional: 2 refuses SNS SignatureVersion 1 (set the topic to version 2 first).
SES_SNS_SIGNATURE_VERSION=
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com
RESEND_WEBHOOK_SECRET=

# Sender identity for account email — activation and password reset. Event
# messages take theirs from each event's message settings; these belong to no
# event. The address must be verified with the delivery provider, and is
# required in production.
ACCOUNT_EMAIL_SENDER_NAME=IMSDA Events
ACCOUNT_EMAIL_SENDER_ADDRESS=
ACCOUNT_EMAIL_REPLY_TO=

# Where alerts go — a Slack or Teams incoming webhook, or anything that accepts
# a JSON POST. Blank means alerts are only written to the log, where nothing is
# watching them. A condition that persists pages once per repeat window.
ALERT_WEBHOOK_URL=
ALERT_REPEAT_MINUTES=60

# Encrypts the values that have to be recoverable rather than hashed — today the
# TOTP secrets behind two-factor authentication. Production requires a random
# value of at least 32 characters. Changing it makes every enrolled
# authenticator unreadable, so rotate it only alongside `npm run
# admin:reset-mfa` for each account.
SECRET_ENCRYPTION_KEY=
# Production loads the key from a root-only file instead of this variable. Set
# SECRET_ENCRYPTION_KEY_FILE to the file's path and leave the line above unset
# (setting both stops startup). See docs/DEPLOY-DOCKER.md.
# SECRET_ENCRYPTION_KEY_FILE=/run/secrets/encryption-key

# Checks a chosen password against a public breach corpus, sending only the
# first five characters of its SHA-1 — the password itself never leaves the
# process. Unset means on in production and off everywhere else. The check
# fails open: an unreachable corpus is logged, not enforced.
PASSWORD_BREACH_CHECK=
PASSWORD_BREACH_CHECK_URL=https://api.pwnedpasswords.com/range/

# Google sign-in for registrants, from a Google Cloud OAuth 2.0 Client ID of
# type "Web application". Leave both blank and the button is hidden rather than
# offered and broken; set both or neither, since half a client fails only after
# the registrant has already handed Google their password.
#
# The authorised redirect URI must be exactly:
#   <APP_BASE_URL>/api/attendee/oauth/google/callback
#
# Registrants only. Staff sign-in stays on a password and an enrolled second
# factor, because Google does not tell us whether a given sign-in used one.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Square checkout stays in Sandbox unless production is explicitly approved.
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_API_URL=https://connect.squareupsandbox.com
SQUARE_API_VERSION=2026-07-15
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must exactly match the notification URL configured in Square.
SQUARE_WEBHOOK_NOTIFICATION_URL=http://localhost:3000/api/webhooks/square
SQUARE_ENABLE_PRODUCTION=false
